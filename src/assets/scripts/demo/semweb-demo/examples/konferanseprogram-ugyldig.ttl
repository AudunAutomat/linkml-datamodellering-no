@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcmitype: <http://purl.org/dc/dcmitype/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

# Foredraget manglar dct:title, som er påkravd (Obligatorisk).
<https://example.org/foredrag/2> a dct:BibliographicResource ;
    dct:creator <https://example.org/person/1> ;
    dct:isPartOf <https://example.org/konferanse/semweb-2026> .

<https://example.org/konferanse/semweb-2026> a dcmitype:Event ;
    dct:title "Semantic Web Conference 2026" .

<https://example.org/person/1> a foaf:Person ;
    foaf:name "Kari Nordmann" .
