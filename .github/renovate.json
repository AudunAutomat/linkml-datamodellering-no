{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "^linkml-datamodellering\\.yaml$"
      ],
      "matchStrings": [
        "ap-no-version:\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "AudunAutomat/linkml-datamodellering-no",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "fileMatch": [
        "^\\.github/workflows/[^/]+\\.ya?ml$"
      ],
      "matchStrings": [
        "AudunAutomat/linkml-datamodellering-no/\\.github/workflows/[^@\\s]+@(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "AudunAutomat/linkml-datamodellering-no",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": [
        "AudunAutomat/linkml-datamodellering-no"
      ],
      "labels": [
        "linkml",
        "dependencies"
      ],
      "commitMessageTopic": "AP-NO (linkml-datamodellering-no)"
    }
  ]
}
